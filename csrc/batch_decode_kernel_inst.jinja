#include <flashinfer/attention/decode.cuh>
#include "batch_decode_config.inc"

using namespace flashinfer;

namespace flashinfer {

// Instantiate the dispatcher function
template cudaError_t
BatchDecodeWithPagedKVCacheDispatched<{{ head_dim_qk }}, {{ pos_encoding_mode }}, {{ variant_name }}, Params>(
    Params params, {{ dtype_o }}* tmp_v,
    float* tmp_s, bool enable_pdl, cudaStream_t stream);

// Also need to explicitly instantiate the WorkEstimation functions and kernels
// These are needed for the partition-kv logic
{% set head_dim = head_dim_qk %}

// Calculate vec_size: max(16 / sizeof(DTypeKV), HEAD_DIM / 32)
{% if dtype_kv == "half" or dtype_kv == "__nv_bfloat16" %}
  {% set dtype_size = 2 %}
{% elif dtype_kv == "__nv_fp8_e4m3" or dtype_kv == "__nv_fp8_e5m2" %}
  {% set dtype_size = 1 %}
{% else %}
  {% set dtype_size = 2 %}
{% endif %}

{% set vec_size_calc = 16 // dtype_size %}
{% set vec_size_max = head_dim // 32 %}
{% set vec_size = [vec_size_calc, vec_size_max] | max %}

{% set bdx = head_dim // vec_size %}

// For sm_120 (compute capability >= 90), NUM_STAGES_SMEM = 2
// Also instantiate NUM_STAGES_SMEM = 1 for WorkEstimation dispatch
{% for num_stages in [1, 2] %}

// GROUP_SIZE = 1
{% set group_size = 1 %}
{% set bdy = group_size %}
{% set tile_size_per_bdx = 4 if dtype_size == 2 else 2 %}
{% set num_threads = [128, bdx * bdy] | max %}
{% set bdz = num_threads // (bdx * bdy) %}
template void BatchDecodeWithPagedKVCacheKernel<
    {{ pos_encoding_mode }}, {{ num_stages }}u, {{ tile_size_per_bdx }}u, 
    {{ vec_size }}u, {{ bdx }}u, {{ bdy }}u, {{ bdz }}u,
    {{ variant_name }}, Params>(Params);

// GROUP_SIZE = 2
{% set group_size = 2 %}
{% set bdy = group_size %}
{% set tile_size_per_bdx = 1 %}
{% set num_threads = [128, bdx * bdy] | max %}
{% set bdz = num_threads // (bdx * bdy) %}
template void BatchDecodeWithPagedKVCacheKernel<
    {{ pos_encoding_mode }}, {{ num_stages }}u, {{ tile_size_per_bdx }}u,
    {{ vec_size }}u, {{ bdx }}u, {{ bdy }}u, {{ bdz }}u,
    {{ variant_name }}, Params>(Params);

// GROUP_SIZE = 3
{% set group_size = 3 %}
{% set bdy = group_size %}
{% set tile_size_per_bdx = 1 %}
{% set num_threads = [128, bdx * bdy] | max %}
{% set bdz = num_threads // (bdx * bdy) %}
template void BatchDecodeWithPagedKVCacheKernel<
    {{ pos_encoding_mode }}, {{ num_stages }}u, {{ tile_size_per_bdx }}u,
    {{ vec_size }}u, {{ bdx }}u, {{ bdy }}u, {{ bdz }}u,
    {{ variant_name }}, Params>(Params);

// GROUP_SIZE = 4
{% set group_size = 4 %}
{% set bdy = group_size %}
{% set tile_size_per_bdx = 1 %}
{% set num_threads = [128, bdx * bdy] | max %}
{% set bdz = num_threads // (bdx * bdy) %}
template void BatchDecodeWithPagedKVCacheKernel<
    {{ pos_encoding_mode }}, {{ num_stages }}u, {{ tile_size_per_bdx }}u,
    {{ vec_size }}u, {{ bdx }}u, {{ bdy }}u, {{ bdz }}u,
    {{ variant_name }}, Params>(Params);

// GROUP_SIZE = 8
{% set group_size = 8 %}
{% set bdy = group_size %}
{% set tile_size_per_bdx = 1 %}
{% set num_threads = [128, bdx * bdy] | max %}
{% set bdz = num_threads // (bdx * bdy) %}
template void BatchDecodeWithPagedKVCacheKernel<
    {{ pos_encoding_mode }}, {{ num_stages }}u, {{ tile_size_per_bdx }}u,
    {{ vec_size }}u, {{ bdx }}u, {{ bdy }}u, {{ bdz }}u,
    {{ variant_name }}, Params>(Params);

{% endfor %}

// Also instantiate WorkEstimation functions for each group size
template cudaError_t BatchDecodeWithPagedKVCacheWorkEstimationDispatched<
    1u, {{ head_dim_qk }}, {{ pos_encoding_mode }}, {{ variant_name }}, Params>(
    bool& split_kv, uint32_t& max_grid_size, uint32_t& max_num_pages_per_batch,
    uint32_t& new_batch_size, uint32_t& gdy,
    uint32_t batch_size, Params::IdType* kv_indptr_h,
    uint32_t num_qo_heads, uint32_t page_size, bool enable_cuda_graph,
    cudaStream_t stream);

