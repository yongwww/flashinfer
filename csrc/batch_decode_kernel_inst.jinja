// We instantiate all combinations that might be used to avoid build failures.
// The dispatcher logic uses:
// - vec_size = max(16 / sizeof(DTypeKV), HEAD_DIM / 32)
// - tile_size_per_bdx = GROUP_SIZE == 1 ? 4 : 1

